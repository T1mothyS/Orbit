# ==================== 用户认证 ====================
# JWT 密钥
JWT_SECRET=replace-with-a-long-random-string
# 可选；未填写时使用 JWT_SECRET 派生验证码 HMAC。
EMAIL_CODE_PEPPER=

# ==================== SMTP / 163 官方邮箱 ====================
# 官方发件邮箱固定为 aicalendarofficial@163.com。
# SMTP_PASS 必须填写 163 邮箱生成的“客户端授权码”，不能填写网页登录密码。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=aicalendarofficial@163.com
SMTP_PASS=replace-with-163-client-authorization-code
# 不需要 REMINDER_RECIPIENT_EMAIL：每位用户在右上角“设置”中配置自己的提醒邮箱；
# 未单独配置时，系统使用该用户的注册邮箱。

# ==================== 用户 QQ 邮箱摘要（可选） ====================
# 用于日报服务端只读读取用户 QQ 收件箱的未读摘要；授权码会以 AES-GCM 加密后保存。
# 生产环境必须使用独立于 JWT_SECRET、BACKUP_ENCRYPTION_KEY 的随机长密钥。
MAIL_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-separate-random-mail-encryption-key

# ==================== 邀请码迁移期引导 ====================
# 首次启动且数据库尚未有邀请码记录时导入并保存为哈希；之后以数据库为唯一生效来源。
# 轮换请在管理员面板中按角色手动触发；不要提交真实邀请码。
ADMIN_INVITE_CODE=replace-with-admin-invite-code
USER_INVITE_CODE=replace-with-user-invite-code

# ==================== 服务器配置 ====================
PORT=3000
APP_TIMEZONE=Asia/Shanghai
# 本模板默认可直接用于本地开发；生产部署时改为正式 HTTPS 地址和 production。
APP_URL=http://localhost:5173/today
APP_ENV=development
# 反向代理层数；本地直连保持 0，Nginx 直接代理到本服务时通常为 1。
TRUST_PROXY_HOPS=0
# 后台提醒、通知队列、邮件导入和备份任务默认关闭；仅在唯一生产 worker 上显式开启。
BACKGROUND_JOBS_ENABLED=false
# Orbit 主动聊天提醒独立于邮件/备份；仅唯一 worker 开启，账号还需在对话侧栏启用。
ORBIT_PROACTIVE_ENABLED=false
# CalDAV 单向桥接：默认关闭；启用后默认使用绑定账号的全部日历。selected 仅用于明确的旧试点，重启生效。
# 完整合同、状态备份和预览确认见 docs/CALDAV-BRIDGE.md。
CALDAV_BRIDGE_ENABLED=false
CALDAV_BRIDGE_WRITE_ENABLED=false
CALDAV_BRIDGE_USER_ID=
CALDAV_BRIDGE_CALENDAR_IDS=
CALDAV_BRIDGE_COLLECTION_URL=
CALDAV_BRIDGE_USERNAME=
CALDAV_BRIDGE_PASSWORD=
CALDAV_BRIDGE_TIMEZONE=Asia/Shanghai
CALDAV_BRIDGE_ALARMS_ENABLED=false
# 已完成源日程默认不投影到手机；源网站数据不会被删除。需要完整历史投影时显式设为 true。
# Compatibility default. Explicitly set true after reviewing the completed/history preview.
# Changing projection policy invalidates prior scope and phone verification.
CALDAV_BRIDGE_INCLUDE_COMPLETED=false
# all 纳入全部日历已排期 event/todo 和全部已存周期（含停用/取消）；完成项由 INCLUDE_COMPLETED 控制；旧日历 ID 保留供迁移核验。
CALDAV_BRIDGE_SCOPE=all
# 仅允许网站启用自动化；仍需全量确认和手机核心验收声明，不会自行开启。
CALDAV_BRIDGE_AUTOMATION_ALLOWED=false
# 第一阶段 Work 文件能力探针；默认关闭，启用时也只写入 data/work-media-probe，不发布日报或发邮件。
WORK_MEDIA_PROBE_ENABLED=false
# Cloud 新媒体批次正式切换开关；第一轮隔离验证保持 false，确认 Work 已能携带 mediaBatchId 后再启用。
CLOUD_DAILY_REPORT_MEDIA_BATCH_REQUIRED=false
# Daily Digest V2.5：默认不启用新工具；允许正式发布的合同默认仍为 v1。
DIGEST_V2_ENABLED=false
DIGEST_SHADOW_ONLY=false
# 独立测试入口另需绝对 DATA_DIR（末级 digest-v2-shadow-data）、专用 PORT、JWT_SECRET 和 HTTPS APP_URL。
# 测试账号使用独立邮箱标识及 bcrypt 密码哈希，不复制生产配置。
DIGEST_SHADOW_LOGIN_EMAIL=
DIGEST_SHADOW_PASSWORD_HASH=
DIGEST_PRODUCTION_CONTRACT=daily-digest.v1
# test 允许测试 r2.dev；production 必须使用自定义 HTTPS 媒体域名。
DIGEST_R2_ENV=test
# 正式版可显式选择 local：使用本站 /daily-report-media/ 的持久文件与既有账号/全站备份；需 HTTPS APP_URL。
# 留空则沿用 R2。正式服务设为 local 时，正式账号的 Shadow 和 production 均使用持久本地媒体；独立隔离服务仍使用测试 R2。
DIGEST_V2_MEDIA_STORE=
DIGEST_R2_ACCOUNT_ID=
DIGEST_R2_BUCKET=
DIGEST_R2_ACCESS_KEY_ID=
DIGEST_R2_SECRET_ACCESS_KEY=
DIGEST_R2_PUBLIC_ORIGIN=
# 服务端审核的来源许可 JSON 文件；未配置时仅允许分类示意图或纯文字。
DIGEST_V2_MEDIA_RULES_FILE=
# Optional authenticated Cloudflare Worker endpoint; configure both or neither.
# Leave unset until the application server can reach this HTTPS endpoint.
DIGEST_MEDIA_RELAY_URL=
DIGEST_MEDIA_RELAY_SECRET=
# Electron 安装包是远程安全壳；构建时会把这个公开 URL 写入安装包（不会写入其他 .env 值）。
ELECTRON_APP_URL=https://your-domain.example/today
# Vite 默认只监听本机。如确需局域网调试，显式设置监听地址和唯一允许的主机名。
# VITE_DEV_HOST=0.0.0.0
# VITE_ALLOWED_HOST=calendar-dev.example.lan
# ==================== 加密灾备 / 阿里云 OSS ====================
# 至少 8 位，生产环境请使用独立随机长密钥
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-long-random-string
# Bucket 必须设为私有并开启阻止公共访问；同地域 ECS 优先使用内网 Endpoint
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 全站恢复时临时设置为 true，正常运行必须保持 false
MAINTENANCE_MODE=false

# ==================== 邮箱自动导入（可选） ====================
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=aicalendarofficial@163.com
IMAP_PASS=

# Optional Orbit AI pilot and free-tier search; never enable background AI implicitly.
# ORBIT_CHATGPT_OWNER_ID=your-orbit-user-id
# TAVILY_API_KEY=
# ORBIT_SEARCH_MONTHLY_LIMIT=1000
# ORBIT_CREDENTIALS_ENCRYPTION_KEY=use-a-strong-service-secret-or-the-protected-local-key

